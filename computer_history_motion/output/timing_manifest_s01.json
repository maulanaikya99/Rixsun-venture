      "units": [
        {
          "index": 0,
          "start": 0.6,
          "end": 5.9405,
          "text": "Benda kecil di saku Anda mampu melakukan miliaran perhitungan setiap detik."
        },
        {
          "index": 1,
          "start": 6.4405,
          "end": 15.2942,
          "text": "Tapi kisahnya dimulai jauh sebelum ada listrik, dari satu pertanyaan sederhana: bagaimana caranya menghitung lebih cepat?"
        },
        {
          "index": 2,
          "start": 15.7942,
          "end": 23.9639,
          "text": "Inilah perjalanan panjang komputer. Dari manik-manik kayu, hingga mesin yang belajar."
        }
      ],
